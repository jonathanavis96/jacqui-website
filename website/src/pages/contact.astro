---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout 
  title="Contact - Jacqui Chowles" 
  description="Get in touch with Jacqui Chowles for therapy appointments and consultancy enquiries."
>
  <Header />

  <!-- JSON-LD: FAQPage (mirrors the visible Common Questions section below) -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Is therapy right for me?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "If you're feeling stuck, overwhelmed, or curious about making a change, therapy might be helpful. You don't need to be in crisis to benefit—many people come to therapy to work through life transitions, improve relationships, or better understand themselves. If you're wondering whether it's right for you, let's have a conversation."
        }
      },
      {
        "@type": "Question",
        "name": "What does the process look like?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "We'll start with an initial consultation to discuss what brings you to therapy and what you're hoping to achieve. From there, we'll work together at a pace that feels right for you. Sessions are typically weekly or fortnightly, and we'll regularly check in on your progress to ensure therapy is meeting your needs."
        }
      },
      {
        "@type": "Question",
        "name": "What are your rates?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Individual therapy (1 hour): R1,400. Couples therapy (90 minutes): R2,100. Consultancy services: contact for a quote. 2026 rates are subject to annual increase. This is a cash-based practice, and invoices are provided for medical aid reimbursement where applicable."
        }
      },
      {
        "@type": "Question",
        "name": "How do I book my first session?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Start by sending me a message via the contact form, email, or WhatsApp. We'll schedule a consultation call to discuss what you're looking for and see if we're a good fit. If we decide to work together, we'll book your first session from there."
        }
      },
      {
        "@type": "Question",
        "name": "How long does therapy take?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Every person's journey is different. Some people benefit from short-term focused work (a few months), while others prefer longer-term therapy. We'll discuss your goals and check in regularly about how things are progressing."
        }
      },
      {
        "@type": "Question",
        "name": "Do you accept medical aid?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "I don't bill medical aid directly, but I can provide invoices for you to submit for reimbursement if your plan covers out-of-network providers or has mental health benefits."
        }
      }
    ]
  })} />

  <main class="flex-grow bg-white">

    <!-- Hero Section -->
    <section class="bg-gradient-to-b from-purple-muted/10 to-white py-16 md:py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto text-center">
          <h1 class="text-4xl md:text-5xl font-heading font-bold text-gray-900 mb-6">
            Get in Touch
          </h1>
          <p class="text-xl text-gray-600 leading-relaxed">
            Book a consultation or reach out with any questions
          </p>
        </div>
      </div>
    </section>

    <!-- Contact Methods & Form Section -->
    <section class="py-16 md:py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <div class="grid md:grid-cols-2 gap-12">
            
            <!-- Left Column - Contact Info & Next Steps -->
            <div class="space-y-10">
              <!-- Contact Information -->
              <div>
                <h2 class="text-2xl md:text-3xl font-heading font-bold text-gray-900 mb-6">
                  Contact Information
                </h2>
                
                <div class="space-y-6">
                  <!-- Email -->
                  <div class="flex items-start">
                  <div class="bg-purple-muted/20 rounded-full p-3 mr-4">
                    <svg class="w-6 h-6 text-purple-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                    </svg>
                  </div>
                  <div>
                    <h3 class="font-heading font-bold text-gray-900 mb-2">Email</h3>
                    <a href="mailto:jacqui@jacquichowles.com" class="text-purple-muted hover:text-purple-muted/90 transition-colors">
                      jacqui@jacquichowles.com
                    </a>
                    <p class="text-gray-600 text-sm mt-2">I typically respond within 24-48 hours</p>
                  </div>
                </div>

                <!-- Phone -->
                <div class="flex items-start">
                  <div class="bg-purple-muted/20 rounded-full p-3 mr-4">
                    <svg class="w-6 h-6 text-purple-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                    </svg>
                  </div>
                  <div>
                    <h3 class="font-heading font-bold text-gray-900 mb-2">Phone</h3>
                    <a href="tel:+27766054736" class="text-purple-muted hover:text-purple-muted/90 transition-colors">
                      +27 76 605 4736
                    </a>
                    <p class="text-gray-600 text-sm mt-2">Call or SMS for enquiries</p>
                  </div>
                </div>

                <!-- WhatsApp -->
                <div class="flex items-start">
                  <div class="bg-purple-muted/20 rounded-full p-3 mr-4">
                    <svg class="w-6 h-6 text-purple-muted" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
                    </svg>
                  </div>
                  <div>
                    <h3 class="font-heading font-bold text-gray-900 mb-2">WhatsApp</h3>
                    <a href="https://wa.me/27766054736" target="_blank" rel="noopener noreferrer" class="text-purple-muted hover:text-purple-muted/90 transition-colors">
                      +27 76 605 4736
                    </a>
                    <p class="text-gray-600 text-sm mt-2">Quick queries and booking requests</p>
                  </div>
                </div>

                <!-- Address -->
                <div class="flex items-start">
                  <div class="bg-purple-muted/20 rounded-full p-3 mr-4">
                    <svg class="w-6 h-6 text-purple-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    </svg>
                  </div>
                  <div>
                    <h3 class="font-heading font-bold text-gray-900 mb-2">In-Person Sessions</h3>
                    <p class="text-gray-700">
                      Argyle Square, Tamarisk Street<br>
                      Weltevreden Park, Roodepoort<br>
                      Gauteng
                    </p>
                    <p class="text-gray-600 text-sm mt-2">By appointment only</p>
                  </div>
                  </div>
                </div>
              </div>

              <!-- What Happens Next -->
              <div class="bg-purple-muted/10 rounded-lg p-6">
                <h3 class="text-xl font-heading font-bold text-gray-900 mb-4">
                  What happens next?
                </h3>
                <ol class="space-y-4">
                  <li class="flex items-start">
                    <span class="bg-purple-muted text-white rounded-full w-6 h-6 flex items-center justify-center text-sm font-bold mr-3 mt-0.5 shrink-0">1</span>
                    <div>
                      <p class="text-gray-700"><strong>I'll respond</strong> within 24-48 hours to acknowledge your message</p>
                    </div>
                  </li>
                  <li class="flex items-start">
                    <span class="bg-purple-muted text-white rounded-full w-6 h-6 flex items-center justify-center text-sm font-bold mr-3 mt-0.5 shrink-0">2</span>
                    <div>
                      <p class="text-gray-700"><strong>Initial consultation</strong> to discuss what you're looking for and answer questions</p>
                    </div>
                  </li>
                  <li class="flex items-start">
                    <span class="bg-purple-muted text-white rounded-full w-6 h-6 flex items-center justify-center text-sm font-bold mr-3 mt-0.5 shrink-0">3</span>
                    <div>
                      <p class="text-gray-700"><strong>Book your first session</strong> if we're a good fit</p>
                    </div>
                  </li>
                </ol>
              </div>
            </div>

            <!-- Right Column - Contact Form -->
            <div class="max-w-xl w-full md:ml-auto">
              <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 md:p-8">
                <h2 class="text-2xl md:text-3xl font-heading font-bold text-gray-900 mb-6">
                  Send a Message
                </h2>
                
                <!-- Formspree Form -->
                <form 
                  id="contact-form"
                  action="https://formspree.io/f/xaqoryvg"
                  method="POST"
                  class="space-y-6"
                >
                <!-- Honeypot for spam prevention -->
                <input type="text" name="_gotcha" style="display:none" />

                <!-- Name -->
                <div>
                  <label for="name" class="block text-gray-700 font-bold mb-2">
                    Your Name <span class="text-red-500">*</span>
                  </label>
                  <input 
                    type="text" 
                    id="name" 
                    name="name" 
                    required 
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-muted focus:border-transparent transition-all"
                    placeholder="Enter your full name"
                  />
                </div>

                <!-- Email -->
                <div>
                  <label for="email" class="block text-gray-700 font-bold mb-2">
                    Email Address <span class="text-red-500">*</span>
                  </label>
                  <input 
                    type="email" 
                    id="email" 
                    name="email" 
                    required 
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-muted focus:border-transparent transition-all"
                    placeholder="your@email.com"
                  />
                </div>

                <!-- Phone (Optional) -->
                <div>
                  <label for="phone" class="block text-gray-700 font-bold mb-2">
                    Phone Number <span class="text-gray-500 font-normal">(optional)</span>
                  </label>
                  <input 
                    type="tel" 
                    id="phone" 
                    name="phone" 
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-muted focus:border-transparent transition-all"
                    placeholder="+27 123 456 789"
                  />
                </div>

                <!-- Service Interest -->
                <div>
                  <label for="service" class="block text-gray-700 font-bold mb-2">
                    I'm interested in <span class="text-red-500">*</span>
                  </label>
                  <select 
                    id="service" 
                    name="service" 
                    required 
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-muted focus:border-transparent transition-all"
                  >
                    <option value="">Select an option</option>
                    <option value="online-therapy">Online Therapy</option>
                    <option value="inperson-therapy">In-Person Therapy</option>
                    <option value="couples-therapy">Couples Therapy</option>
                    <option value="consultancy">Consultancy Services</option>
                    <option value="other">Other / Not sure yet</option>
                  </select>
                </div>

                <!-- Message -->
                <div>
                  <label for="message" class="block text-gray-700 font-bold mb-2">
                    Message <span class="text-red-500">*</span>
                  </label>
                  <textarea 
                    id="message" 
                    name="message" 
                    required 
                    rows="6" 
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-muted focus:border-transparent transition-all resize-none"
                    placeholder="Tell me a bit about what you're looking for or any questions you have..."
                  ></textarea>
                </div>

                <!-- Privacy Note -->
                <div class="text-sm text-gray-600 bg-gray-50 p-4 rounded-lg">
                  <p><strong>Privacy note:</strong> Your information will be kept confidential and used only to respond to your enquiry. By submitting this form, you consent to me contacting you regarding your message.</p>
                </div>

                <!-- Submit Button -->
                <button 
                  type="submit" 
                  class="w-full bg-purple-brand hover:bg-purple-brand-hover text-white font-bold py-4 px-8 rounded-lg transition-colors text-lg"
                >
                  Send Message
                </button>
              </form>
              </div>
            </div>

          </div>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="py-16 md:py-20 bg-purple-muted/10">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold text-gray-900 mb-10 text-center">
            Common Questions
          </h2>

          <div class="space-y-4">
            <!-- FAQ Item - Is therapy right for me? -->
            <details class="bg-white rounded-lg shadow-sm group">
              <summary class="flex justify-between items-center cursor-pointer p-6 hover:bg-gray-50 transition-colors">
                <h3 class="text-xl font-heading font-bold text-gray-900">
                  Is therapy right for me?
                </h3>
                <svg class="w-6 h-6 text-purple-muted transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                </svg>
              </summary>
              <div class="px-6 pb-6">
                <p class="text-gray-700">
                  If you're feeling stuck, overwhelmed, or curious about making a change, therapy might be helpful. You don't need to be in crisis to benefit—many people come to therapy to work through life transitions, improve relationships, or better understand themselves. If you're wondering whether it's right for you, let's have a conversation.
                </p>
              </div>
            </details>

            <!-- FAQ Item - What does the process look like? -->
            <details class="bg-white rounded-lg shadow-sm group">
              <summary class="flex justify-between items-center cursor-pointer p-6 hover:bg-gray-50 transition-colors">
                <h3 class="text-xl font-heading font-bold text-gray-900">
                  What does the process look like?
                </h3>
                <svg class="w-6 h-6 text-purple-muted transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                </svg>
              </summary>
              <div class="px-6 pb-6">
                <p class="text-gray-700">
                  We'll start with an initial consultation to discuss what brings you to therapy and what you're hoping to achieve. From there, we'll work together at a pace that feels right for you. Sessions are typically weekly or fortnightly, and we'll regularly check in on your progress to ensure therapy is meeting your needs.
                </p>
              </div>
            </details>

            <!-- FAQ Item - What are your rates? -->
            <details class="bg-white rounded-lg shadow-sm group">
              <summary class="flex justify-between items-center cursor-pointer p-6 hover:bg-gray-50 transition-colors">
                <h3 class="text-xl font-heading font-bold text-gray-900">
                  What are your rates?
                </h3>
                <svg class="w-6 h-6 text-purple-muted transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                </svg>
              </summary>
              <div class="px-6 pb-6">
                <p class="text-gray-700 mb-3">
                  My rates are as follows:
                </p>
                <ul class="text-gray-700 space-y-2 ml-4">
                  <li>• Individual therapy (1 hour): <strong>R1,400*</strong></li>
                  <li>• Couples therapy (90 minutes): <strong>R2,100*</strong></li>
                  <li>• Consultancy services: <strong>Contact for quote</strong></li>
                </ul>
                <p class="text-xs text-gray-500 mt-2 ml-4">
                  *2026 rates subject to annual increase
                </p>
                <p class="text-gray-700 mt-3">
                  This is a cash-based practice. Invoices are provided for medical aid reimbursement where applicable.
                </p>
              </div>
            </details>

            <!-- FAQ Item - How do I book? -->
            <details class="bg-white rounded-lg shadow-sm group">
              <summary class="flex justify-between items-center cursor-pointer p-6 hover:bg-gray-50 transition-colors">
                <h3 class="text-xl font-heading font-bold text-gray-900">
                  How do I book my first session?
                </h3>
                <svg class="w-6 h-6 text-purple-muted transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                </svg>
              </summary>
              <div class="px-6 pb-6">
                <p class="text-gray-700">
                  Start by sending me a message via the form above, email, or WhatsApp. We'll schedule a consultation call to discuss what you're looking for and see if we're a good fit. If we decide to work together, we'll book your first session from there.
                </p>
              </div>
            </details>

            <!-- FAQ Item - How long does therapy take? -->
            <details class="bg-white rounded-lg shadow-sm group">
              <summary class="flex justify-between items-center cursor-pointer p-6 hover:bg-gray-50 transition-colors">
                <h3 class="text-xl font-heading font-bold text-gray-900">
                  How long does therapy take?
                </h3>
                <svg class="w-6 h-6 text-purple-muted transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                </svg>
              </summary>
              <div class="px-6 pb-6">
                <p class="text-gray-700">
                  Every person's journey is different. Some people benefit from short-term focused work (a few months), while others prefer longer-term therapy. We'll discuss your goals and check in regularly about how things are progressing.
                </p>
              </div>
            </details>

            <!-- FAQ Item - Medical aid -->
            <details class="bg-white rounded-lg shadow-sm group">
              <summary class="flex justify-between items-center cursor-pointer p-6 hover:bg-gray-50 transition-colors">
                <h3 class="text-xl font-heading font-bold text-gray-900">
                  Do you accept medical aid?
                </h3>
                <svg class="w-6 h-6 text-purple-muted transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                </svg>
              </summary>
              <div class="px-6 pb-6">
                <p class="text-gray-700">
                  I don't bill medical aid directly, but I can provide invoices for you to submit for reimbursement if your plan covers out-of-network providers or has mental health benefits.
                </p>
              </div>
            </details>
          </div>
        </div>
      </div>
    </section>

    <!-- Bottom CTA -->
    <section class="py-16 md:py-20 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-3xl mx-auto text-center">
          <h2 class="text-3xl md:text-4xl font-heading font-bold text-gray-900 mb-6">
            Still have questions?
          </h2>
          <p class="text-xl text-gray-600 mb-8">
            Don't hesitate to reach out. I'm here to help and answer any questions you may have.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a 
              href="mailto:jacqui@jacquichowles.com" 
              class="inline-block bg-purple-brand hover:bg-purple-brand-hover text-white font-bold py-4 px-8 rounded-lg transition-colors text-lg"
            >
              Send an email
            </a>
            <a 
              href={`${base}services`}
              class="inline-block bg-white hover:bg-gray-50 text-purple-brand font-bold py-4 px-8 rounded-lg border-2 border-purple-brand transition-colors text-lg"
            >
              View services
            </a>
          </div>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>
