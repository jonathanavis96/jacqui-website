---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Message sent - Jacqui Chowles"
  description="Thank you for reaching out. Jacqui Chowles will respond within 24-48 hours."
  noindex={true}
>
  <Header />

  <main class="flex-grow bg-white">
    <section class="py-20 md:py-28">
      <div class="container mx-auto px-4">
        <div class="max-w-xl mx-auto text-center">
          <div class="bg-purple-muted text-white rounded-full w-16 h-16 flex items-center justify-center mx-auto mb-6">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
          </div>

          <h1 class="text-3xl md:text-4xl font-heading font-bold text-gray-900 mb-4">
            Thank you for your message
          </h1>

          <p class="text-lg text-gray-700 mb-3">
            Your message has been received. I'll respond within <strong>24-48 hours</strong> to acknowledge it and discuss next steps.
          </p>

          <p class="text-gray-700 mb-10">
            If your enquiry is urgent, please see the <a href={`${base}contact/`} class="text-purple-muted underline hover:no-underline">contact page</a> for phone and WhatsApp details.
          </p>

          <a
            href={`${base}`}
            class="inline-block bg-purple-muted hover:bg-purple-brand text-white font-bold py-4 px-8 rounded-lg transition-colors text-lg"
          >
            Back to homepage
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
