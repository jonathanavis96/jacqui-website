---
const currentYear = new Date().getFullYear();
const base = import.meta.env.BASE_URL;
---

<footer class="bg-gray-50 border-t border-gray-200 mt-auto">
  <div class="container mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Brand -->
      <div>
        <h3 class="text-xl font-heading font-bold text-gray-900 mb-4">
          Jacqui Chowles
        </h3>
        <p class="text-gray-600 text-sm">
          Counselling Psychologist
        </p>
      </div>
      
      <!-- Contact Info -->
      <div>
        <h4 class="font-heading font-bold text-gray-900 mb-4">Contact</h4>
        <ul class="space-y-2 text-sm text-gray-600">
          <li>
            <a href="mailto:jacqui@jacquichowles.com" class="hover:text-gray-900 transition-colors">
              jacqui@jacquichowles.com
            </a>
          </li>
          <li>
            <a href="tel:+27766054736" class="hover:text-gray-900 transition-colors">
              +27 76 605 4736
            </a>
          </li>
          <li>
            <a href="https://wa.me/27766054736" target="_blank" rel="noopener noreferrer" class="hover:text-gray-900 transition-colors">
              WhatsApp
            </a>
          </li>
        </ul>
      </div>
      
      <!-- Quick Links -->
      <div>
        <h4 class="font-heading font-bold text-gray-900 mb-4">Quick Links</h4>
        <ul class="space-y-2 text-sm text-gray-600">
          <li>
            <a href={`${base}about`} class="hover:text-gray-900 transition-colors">About</a>
          </li>
          <li>
            <a href={`${base}services`} class="hover:text-gray-900 transition-colors">Services</a>
          </li>
          <li>
            <a href={`${base}contact`} class="hover:text-gray-900 transition-colors">Contact</a>
          </li>
        </ul>
      </div>
    </div>
    
    <div class="mt-8 pt-8 border-t border-gray-200 text-center text-sm text-gray-500">
      <p>&copy; {currentYear} Jacqui Chowles. All rights reserved.</p>
      <p class="mt-1 text-xs text-gray-400">
        Built and maintained by
        <a
          href="https://alldonesites.com"
          target="_blank"
          rel="noopener"
          class="underline-offset-2 transition-colors hover:text-gray-900 hover:underline"
        >
          All Done Sites
        </a>
      </p>
    </div>
  </div>
</footer>
