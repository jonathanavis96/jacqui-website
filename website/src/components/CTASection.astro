---
// Call-to-action section for homepage
const base = import.meta.env.BASE_URL;
---

<section class="bg-[#78716C] py-16 md:py-20">
  <div class="container mx-auto px-4">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-3xl md:text-4xl font-heading font-bold text-white mb-6">
        Ready to take the first step?
      </h2>
      <p class="text-xl text-purple-50 mb-8 leading-relaxed">
        Book a consultation to see if we're a good fit. No pressure, just an opportunity to ask questions and discuss your needs.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a 
          href={`${base}contact/`}
          class="inline-block bg-purple-brand hover:bg-purple-brand-hover text-white font-bold py-4 px-8 rounded-lg transition-colors text-lg"
        >
          Book a consultation
        </a>
        <a 
          href={`${base}about/`}
          class="inline-block bg-white hover:bg-gray-100 text-purple-brand font-bold py-4 px-8 rounded-lg transition-colors text-lg"
        >
          Learn about my approach
        </a>
      </div>
    </div>
  </div>
</section>
