---
// Hero section - Homepage above the fold
const base = import.meta.env.BASE_URL;
---

<section class="bg-gradient-to-b from-purple-50 to-white py-20 md:py-28">
  <div class="container mx-auto px-4">
    <div class="max-w-4xl mx-auto text-center">
      <!-- Main Headline -->
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold text-gray-900 mb-6">
        Compassionate therapy for life's difficult moments
      </h1>
      
      <!-- Subheadline -->
      <p class="text-xl md:text-2xl text-gray-600 mb-8 leading-relaxed">
        Online and in-person therapy for trauma, anxiety, depression, and life transitions—in a safe, non-judgmental space.
      </p>
      
      <!-- Trust Line -->
      <p class="text-sm md:text-base text-gray-500 mb-10">
        Registered Counselling Psychologist (HPCSA) • Over a decade of experience across Africa and internationally
      </p>
      
      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a 
          href={`${base}contact`}
          class="inline-block bg-purple-brand hover:bg-purple-brand-hover text-white font-bold py-4 px-8 rounded-lg transition-colors text-lg"
        >
          Book a consultation
        </a>
        <a 
          href={`${base}services`}
          class="inline-block bg-white hover:bg-gray-50 text-purple-brand font-bold py-4 px-8 rounded-lg border-2 border-purple-brand transition-colors text-lg"
        >
          Learn more
        </a>
      </div>
    </div>
  </div>
</section>
