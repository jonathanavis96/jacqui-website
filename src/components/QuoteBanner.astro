---
// Reusable quote banner component with curved purple border
interface Props {
  quote: string;
  author: string;
  backgroundImage?: string;
}

const { quote, author, backgroundImage = '' } = Astro.props;

// Unified wave path ID for clip-path reference
const waveId = `wave-${Math.random().toString(36).substr(2, 9)}`;
---

<section class="relative py-20 md:py-24 overflow-hidden">
  <!-- Hidden SVG for clip-path definition -->
  <svg class="absolute w-0 h-0" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <clipPath id={waveId} clipPathUnits="objectBoundingBox" transform="scale(0.000833333, 0.00833333)">
        <!-- Smooth bezier wave: 0% at left, gentle rise to ~1% at 27%, flat ~1% to 54%, gentle dip to 2.6% at 62%, rise to 6% at 75%, level to 8% at 100% -->
        <path d="M 0,120 C 80,115 160,108 240,105 C 320,102 400,100 480,100 C 560,100 640,102 720,108 C 800,114 880,122 960,126 C 1040,130 1120,130 1160,130 L 1200,130 L 1200,1200 L 0,1200 Z" />
      </clipPath>
    </defs>
  </svg>
  
  <!-- Curved purple border stroke at top (12px width) -->
  <div class="absolute top-0 left-0 w-full overflow-hidden leading-none z-10">
    <svg class="relative block w-full h-16" viewBox="0 0 1200 120" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <!-- Same wave path as clip-path, but stroked instead of filled -->
      <path d="M 0,120 C 80,115 160,108 240,105 C 320,102 400,100 480,100 C 560,100 640,102 720,108 C 800,114 880,122 960,126 C 1040,130 1120,130 1160,130 L 1200,130" fill="none" stroke="#8F65AB" stroke-width="12" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </div>
  
  <!-- Background image with overlay and wave-clipped top -->
  {backgroundImage && (
    <div 
      class="absolute inset-0 bg-cover bg-center bg-no-repeat" 
      style={`background-image: url('${backgroundImage}'); clip-path: url(#${waveId});`}
    >
      <div class="absolute inset-0 bg-gray-900 opacity-30"></div>
    </div>
  )}
  
  <!-- Fallback solid background if no image -->
  {!backgroundImage && (
    <div class="absolute inset-0 bg-gradient-to-br from-purple-900 to-purple-800" style={`clip-path: url(#${waveId});`}></div>
  )}
  
  <!-- Quote content -->
  <div class="container mx-auto px-4 relative z-10">
    <div class="max-w-4xl mx-auto text-center">
      <svg class="w-12 h-12 md:w-16 md:h-16 text-purple-300 mx-auto mb-6 opacity-50" fill="currentColor" viewBox="0 0 24 24">
        <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
      </svg>
      
      <blockquote class="text-xl md:text-2xl lg:text-3xl text-white italic leading-relaxed mb-6">
        {quote}
      </blockquote>
      
      <cite class="text-base md:text-lg text-purple-200 not-italic font-semibold">
        — {author}
      </cite>
    </div>
  </div>
  
  <!-- Curved purple border at bottom -->
  <div class="absolute bottom-0 left-0 w-full overflow-hidden leading-none rotate-180">
    <svg class="relative block w-full h-12" viewBox="0 0 1200 120" preserveAspectRatio="none">
      <path d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V0H0V27.35A600.21,600.21,0,0,0,321.39,56.44Z" fill="#8F65AB"></path>
    </svg>
  </div>
</section>
