---
// Reusable service card component
interface Props {
  title: string;
  description: string;
  href: string;
  icon?: string;
}

const { title, description, href, icon = '🔹' } = Astro.props;
---

<a 
  href={href}
  class="block p-6 bg-white rounded-lg shadow-md hover:shadow-xl transition-shadow border border-gray-100 hover:border-blue-200"
>
  <div class="text-4xl mb-4">{icon}</div>
  <h3 class="text-2xl font-heading font-bold text-gray-900 mb-3">
    {title}
  </h3>
  <p class="text-gray-600 mb-4 leading-relaxed">
    {description}
  </p>
  <span class="text-blue-600 font-semibold inline-flex items-center">
    Learn more 
    <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
    </svg>
  </span>
</a>
