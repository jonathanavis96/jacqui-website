---
// Reusable service card component
interface Props {
  title: string;
  description: string;
  href: string;
  icon?: string;
}

const base = import.meta.env.BASE_URL;
const { title, description, href, icon = '🔹' } = Astro.props;
// Prepend base to href if it starts with /
const fullHref = href.startsWith('/') ? `${base}${href.slice(1)}` : href;
---

<a 
  href={fullHref}
  class="flex flex-col h-full p-6 bg-white rounded-lg shadow-md hover:shadow-xl transition-shadow border border-gray-100 hover:border-purple-200"
>
  <div class="text-4xl mb-4">{icon}</div>
  <h3 class="text-2xl font-heading font-bold text-gray-900 mb-3">
    {title}
  </h3>
  <p class="text-gray-600 mb-4 leading-relaxed flex-grow">
    {description}
  </p>
  <span class="text-purple-brand font-semibold inline-flex items-center mt-auto">
    Learn more 
    <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
    </svg>
  </span>
</a>
