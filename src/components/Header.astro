---
const navItems = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/services', label: 'Services' },
  { href: '/contact', label: 'Contact' },
];

const currentPath = Astro.url.pathname;
---

<header class="bg-white shadow-sm sticky top-0 z-50">
  <nav class="container mx-auto px-4 py-4">
    <div class="flex items-center justify-between">
      <!-- Logo/Brand -->
      <a href="/" class="flex items-center">
        <img 
          src="/images/JacquiChowlesLogo.webp" 
          alt="Jacqui Chowles - Counselling Psychologist" 
          class="h-12 w-auto"
        />
      </a>
      
      <!-- Desktop Navigation -->
      <ul class="hidden md:flex space-x-8">
        {navItems.map((item) => (
          <li>
            <a 
              href={item.href}
              class={`text-gray-700 hover:text-gray-900 transition-colors ${
                currentPath === item.href || (currentPath.startsWith(item.href) && item.href !== '/')
                  ? 'font-bold border-b-2 border-gray-900'
                  : ''
              }`}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      
      <!-- Mobile Menu Button -->
      <button 
        id="mobile-menu-button"
        class="md:hidden p-2 rounded-lg hover:bg-gray-100 transition-colors"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
    
    <!-- Mobile Navigation -->
    <div id="mobile-menu" class="hidden md:hidden mt-4 pb-4">
      <ul class="flex flex-col space-y-2">
        {navItems.map((item) => (
          <li>
            <a 
              href={item.href}
              class={`block px-4 py-2 rounded-lg text-gray-700 hover:bg-gray-100 transition-colors ${
                currentPath === item.href || (currentPath.startsWith(item.href) && item.href !== '/')
                  ? 'font-bold bg-gray-100'
                  : ''
              }`}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>
</header>

<script>
  // Mobile menu toggle
  const button = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  
  button?.addEventListener('click', () => {
    const isExpanded = button.getAttribute('aria-expanded') === 'true';
    button.setAttribute('aria-expanded', String(!isExpanded));
    menu?.classList.toggle('hidden');
  });
</script>
