---
// Trust markers section - HPCSA credentials and Psychology Today badge
---

<section class="bg-gray-50 py-12">
  <div class="container mx-auto px-4">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-center text-2xl font-heading font-bold text-gray-900 mb-8">
        Qualified & Registered
      </h2>
      
      <div class="flex flex-col md:flex-row items-center justify-center gap-8 md:gap-12">
        <!-- HPCSA Registration -->
        <div class="text-center">
          <div class="inline-flex items-center justify-center w-20 h-20 bg-purple-100 rounded-full mb-4">
            <svg class="w-10 h-10 text-purple-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <h3 class="font-bold text-gray-900 mb-2">HPCSA Registered</h3>
          <p class="text-sm text-gray-600">Counselling Psychologist</p>
          <p class="text-xs text-gray-500 mt-1">Registration No. PS0119891</p>
        </div>
        
        <!-- Psychology Today Verification -->
        <div class="text-center">
          <div class="inline-flex items-center justify-center w-20 h-20 bg-green-100 rounded-full mb-4">
            <svg class="w-10 h-10 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="font-bold text-gray-900 mb-2">Psychology Today</h3>
          <p class="text-sm text-gray-600">Verified Profile</p>
          <p class="text-xs text-gray-500 mt-1">
            <a href="https://www.psychologytoday.com/za/counselling/jacqui-leigh-chowles-roodepoort-gt/989696" target="_blank" rel="noopener" class="text-purple-brand hover:underline">
              View profile →
            </a>
          </p>
        </div>
        
        <!-- Years of Experience -->
        <div class="text-center">
          <div class="inline-flex items-center justify-center w-20 h-20 bg-purple-100 rounded-full mb-4">
            <span class="text-3xl font-bold text-purple-brand">10+</span>
          </div>
          <h3 class="font-bold text-gray-900 mb-2">Years Experience</h3>
          <p class="text-sm text-gray-600">Across Africa & internationally</p>
        </div>
      </div>
    </div>
  </div>
</section>
