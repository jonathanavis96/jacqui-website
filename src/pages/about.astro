---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import QuoteBanner from '../components/QuoteBanner.astro';
import TrustBadges from '../components/TrustBadges.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout 
  title="About - Jacqui Chowles" 
  description="Learn about Jacqui Chowles' background, approach, and areas of expertise in counselling psychology."
>
  <Header />
  <main class="flex-grow bg-white">
    
    <!-- Hero Section -->
    <section class="bg-gradient-to-b from-purple-50 to-white py-16 md:py-20 pb-2 md:pb-3">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto text-center">
          <h1 class="text-4xl md:text-5xl font-heading font-bold text-gray-900 mb-6">
            About Me
          </h1>
          <p class="text-xl text-gray-600 leading-relaxed">
            Over a decade of experience providing compassionate, trauma-informed therapy across Africa and internationally
          </p>
        </div>
      </div>
    </section>

    <!-- Bio Section -->
    <section class="pt-2 md:pt-3 pb-16 md:pb-20">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <!-- Jacqui's Photo -->
          <div class="mb-12 flex justify-center">
            <img 
              src={`${base}images/jacqui_headshot.png`}
              alt="Jacqui Chowles - Counselling Psychologist" 
              class="w-80 h-auto rounded-lg object-cover shadow-lg"
            />
          </div>

          <div class="prose prose-lg max-w-none">
            <p class="text-gray-700 leading-relaxed mb-6">
              I'm a registered Counselling Psychologist with a deep passion for helping people heal and grow. Over the years, I've had the privilege of working in various settings—hospitals, government facilities, organisations, and private practice—which has given me a broad understanding of human challenges and resilience.
            </p>

            <p class="text-gray-700 leading-relaxed mb-6">
              My approach is grounded in warmth, empathy, and a genuine belief in your ability to navigate life's difficulties. Therapy, for me, is about creating a safe, supportive space where you can explore your thoughts and emotions at your own pace. I tailor my therapeutic style to suit your unique needs, drawing from evidence-based approaches like psychodynamic and trauma-focused therapy, EMDR, mindfulness, and relational techniques.
            </p>

            <p class="text-gray-700 leading-relaxed mb-6">
              Whether you're dealing with anxiety, depression, trauma, relationship difficulties, or life transitions, I'm here to walk alongside you as you work toward healing and personal growth.
            </p>

            <!-- Pull Quote -->
            <blockquote class="border-l-4 border-purple-brand pl-6 py-4 my-12 italic text-xl text-gray-700">
              "Therapy is about creating a safe space where you can explore your experiences, understand your patterns, and find your way forward—at your own pace."
            </blockquote>
          </div>
        </div>
      </div>
    </section>

    <!-- How I Work Section -->
    <section class="py-16 md:py-20 bg-purple-50">
      <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
          <!-- Image + Text Grid -->
          <div class="grid md:grid-cols-2 gap-8 md:gap-12 items-center mb-8">
            <!-- Mirror Image (Left) -->
            <div class="order-2 md:order-1">
              <img 
                src={`${base}images/image3_mirror.webp`}
                alt="Reflective mirror symbolizing self-exploration in therapy" 
                class="max-w-xs w-full h-auto rounded-lg shadow-lg object-cover"
              />
            </div>

            <!-- Text (Right) -->
            <div class="order-1 md:order-2 prose prose-lg">
              <h2 class="text-3xl md:text-4xl font-heading font-bold text-gray-900 mb-8 text-left">
                How I Work
              </h2>

              <p class="text-gray-700 leading-relaxed mb-6">
                I believe therapy works best when it feels collaborative and supportive. My style is warm, empathetic, and non-judgmental—I aim to create a space where you feel truly heard and understood.
              </p>

              <p class="text-gray-700 leading-relaxed mb-6">
                I draw from a range of therapeutic approaches, including psychodynamic therapy, EMDR, mindfulness-based techniques, and relational therapy. This allows me to tailor our sessions to what works best for you, whether that's exploring past experiences, building coping strategies, or focusing on the present moment.
              </p>

              <p class="text-gray-700 leading-relaxed mb-6">
                Our work together is guided by your goals. Whether you're looking to process a difficult experience, manage overwhelming emotions, or simply feel more like yourself again, I'll meet you where you are and support you every step of the way.
              </p>
            </div>
          </div>

          <div class="max-w-4xl mx-auto prose prose-lg">

            <div class="bg-white rounded-lg p-8 my-8">
              <h3 class="text-2xl font-heading font-bold text-gray-900 mb-4">
                What to expect
              </h3>
              <ul class="space-y-4">
                <li class="flex items-start">
                  <span class="text-purple-brand mr-3 text-xl">•</span>
                  <span class="text-gray-700"><strong>A safe, non-judgmental space</strong> where you can speak openly about your experiences</span>
                </li>
                <li class="flex items-start">
                  <span class="text-purple-brand mr-3 text-xl">•</span>
                  <span class="text-gray-700"><strong>A collaborative relationship</strong> where we work together to understand your concerns and goals</span>
                </li>
                <li class="flex items-start">
                  <span class="text-purple-brand mr-3 text-xl">•</span>
                  <span class="text-gray-700"><strong>Trauma-informed care</strong> that respects your pace and honors your experiences</span>
                </li>
                <li class="flex items-start">
                  <span class="text-purple-brand mr-3 text-xl">•</span>
                  <span class="text-gray-700"><strong>A focus on relationships</strong>—both the relationship between us and your relationships with others</span>
                </li>
              </ul>
            </div>

            <p class="text-gray-700 leading-relaxed">
              I work with individuals, adolescents, and couples, tailoring my approach to what feels right for you.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- What I Work With Section -->
    <section class="py-16 md:py-20 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
          <!-- Main Grid: Left column (h2 + intro + 4 cards) + Right column (image) -->
          <div class="grid md:grid-cols-2 gap-8 md:gap-12 mb-10">
            <!-- Left Column -->
            <div class="order-1 md:order-1">
              <h2 class="text-3xl md:text-4xl font-heading font-bold text-gray-900 mb-6 text-left">
                What I Work With
              </h2>

              <div class="prose prose-lg mb-6">
                <p class="text-gray-700 leading-relaxed">
                  I work with people experiencing a wide range of concerns. Some common areas include:
                </p>
              </div>

              <!-- First 4 cards in left column -->
              <div class="grid grid-cols-1 gap-6">
            <!-- Anxiety & Stress -->
            <div class="bg-purple-50 rounded-lg p-6">
              <h3 class="text-xl font-heading font-bold text-gray-900 mb-3">
                Anxiety & Stress
              </h3>
              <p class="text-gray-700">
                Generalized anxiety, panic, social anxiety, work-related stress, and worry that impacts your daily life.
              </p>
            </div>

            <!-- Depression -->
            <div class="bg-purple-50 rounded-lg p-6">
              <h3 class="text-xl font-heading font-bold text-gray-900 mb-3">
                Depression
              </h3>
              <p class="text-gray-700">
                Including postpartum depression, persistent low mood, and feelings of hopelessness.
              </p>
            </div>

            <!-- Trauma & PTSD -->
            <div class="bg-purple-50 rounded-lg p-6">
              <h3 class="text-xl font-heading font-bold text-gray-900 mb-3">
                Trauma & PTSD
              </h3>
              <p class="text-gray-700">
                Working through the lasting effects of traumatic experiences, including childhood trauma, violence, and loss.
              </p>
            </div>

            <!-- Grief & Loss -->
            <div class="bg-purple-50 rounded-lg p-6">
              <h3 class="text-xl font-heading font-bold text-gray-900 mb-3">
                Grief & Loss
              </h3>
              <p class="text-gray-700">
                Navigating bereavement, loss, and the complex emotions that come with endings.
              </p>
            </div>
              </div>
            </div>

            <!-- Right Column: Image -->
            <div class="order-2 md:order-2 flex items-center justify-center">
              <img 
                src={`${base}images/image4_butterfly.webp`}
                alt="Butterfly symbolizing transformation and growth" 
                class="max-w-sm w-full h-auto rounded-lg shadow-lg object-cover"
              />
            </div>
          </div>

          <!-- Remaining 4 cards below -->
          <div class="max-w-4xl mx-auto">
            <div class="grid md:grid-cols-2 gap-6">
            <!-- Relationship Difficulties -->
            <div class="bg-purple-50 rounded-lg p-6">
              <h3 class="text-xl font-heading font-bold text-gray-900 mb-3">
                Relationship Difficulties
              </h3>
              <p class="text-gray-700">
                Communication challenges, conflict patterns, intimacy issues, and building deeper connection.
              </p>
            </div>

            <!-- Life Transitions -->
            <div class="bg-purple-50 rounded-lg p-6">
              <h3 class="text-xl font-heading font-bold text-gray-900 mb-3">
                Life Transitions
              </h3>
              <p class="text-gray-700">
                Major changes like relocation, career shifts, relationship changes, and identity exploration.
              </p>
            </div>

            <!-- Self-Esteem & Identity -->
            <div class="bg-purple-50 rounded-lg p-6">
              <h3 class="text-xl font-heading font-bold text-gray-900 mb-3">
                Self-Esteem & Identity
              </h3>
              <p class="text-gray-700">
                Questions about who you are, self-worth, belonging, cultural identity, and self-understanding.
              </p>
            </div>

            <!-- Women's Mental Health & Perinatal Wellbeing -->
            <div class="bg-purple-50 rounded-lg p-6">
              <h3 class="text-xl font-heading font-bold text-gray-900 mb-3">
                Women's Mental Health & Perinatal Wellbeing
              </h3>
              <p class="text-gray-700">
                Pregnancy, postpartum experiences, fertility challenges, and women's mental health across the lifespan.
              </p>
            </div>
          </div>

          <p class="text-gray-600 mt-10 italic">
            This is not an exhaustive list. If you're unsure whether I can help with what you're going through, please reach out—we can discuss it together.
          </p>
        </div>
      </div>
    </section>

    <!-- Inspirational Quote -->
    <QuoteBanner
      quote="It's the relationship that heals, the relationship heals by providing a space where the patient feels safe to explore the depths of their mind and spirit, knowing that someone will be there to witness, understand, and support their journey."
      author="Irvin D. Yalom"
      backgroundImage="/images/Road_About_Banner.webp"
    />

    <!-- Credentials Section -->
    <section class="py-16 md:py-20 bg-gradient-to-b from-white to-purple-50">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold text-gray-900 mb-8 text-center">
            Professional Credentials
          </h2>

          <div class="bg-white rounded-lg shadow-md p-8 mb-12">
            <div class="space-y-6">
              <div>
                <h3 class="text-xl font-heading font-bold text-gray-900 mb-2">
                  Registration
                </h3>
                <p class="text-gray-700">
                  Registered Counselling Psychologist with the Health Professions Council of South Africa (HPCSA)
                </p>
              </div>

              <div>
                <h3 class="text-xl font-heading font-bold text-gray-900 mb-2">
                  Education
                </h3>
                <p class="text-gray-700">
                  Master's Degree in Counselling Psychology, University of the Witwatersrand
                </p>
              </div>

              <div>
                <h3 class="text-xl font-heading font-bold text-gray-900 mb-2">
                  Experience
                </h3>
                <ul class="text-gray-700 space-y-2">
                  <li>• Over 10 years of clinical experience</li>
                  <li>• Work across Africa including South Africa, The Gambia, and other countries</li>
                  <li>• Collaboration with international organisations including UNDP</li>
                  <li>• Community-based mental health programs and post-conflict support</li>
                  <li>• Private practice specialising in trauma, depression, and anxiety</li>
                </ul>
              </div>
            </div>
          </div>

          <!-- Trust Badges Component -->
          <TrustBadges />
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-16 md:py-20 bg-purple-brand text-white">
      <div class="container mx-auto px-4">
        <div class="max-w-3xl mx-auto text-center">
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-6">
            Ready to take the next step?
          </h2>
          <p class="text-xl mb-8 text-purple-100">
            Book a consultation to see if we're a good fit, or learn more about how I work.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a 
              href={`${base}contact`}
              class="inline-block bg-white hover:bg-gray-100 text-purple-brand font-bold py-4 px-8 rounded-lg transition-colors text-lg"
            >
              Get in touch
            </a>
            <a 
              href={`${base}services`}
              class="inline-block bg-transparent hover:bg-white/10 text-white font-bold py-4 px-8 rounded-lg border-2 border-white transition-colors text-lg"
            >
              View services
            </a>
          </div>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>
