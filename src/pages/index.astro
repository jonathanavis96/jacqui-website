---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import TrustBadges from '../components/TrustBadges.astro';
import CTASection from '../components/CTASection.astro';
import QuoteBanner from '../components/QuoteBanner.astro';
---

<BaseLayout title="Jacqui Chowles - Therapy & Counselling">
  <Header />
  
  <main id="main-content" class="flex-grow">
    <!-- Hero Section -->
    <Hero />
    
    <!-- Services Overview Section -->
    <section class="py-16 md:py-20 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-12 fade-in">
            <h2 class="text-3xl md:text-4xl font-heading font-bold text-gray-900 mb-4">
              How I can help
            </h2>
            <p class="text-xl text-gray-600 max-w-2xl mx-auto">
              Whether you're working through trauma, navigating life transitions, or seeking support for anxiety or depression—I'm here to help.
            </p>
          </div>
          
          <!-- Service Cards Grid -->
          <div class="grid md:grid-cols-3 gap-8 fade-in">
            <ServiceCard 
              title="Online Therapy"
              description="Individual therapy sessions via secure video call. Work with me from anywhere in South Africa or internationally."
              href="/services#online"
              icon="💻"
            />
            
            <ServiceCard 
              title="In-Person Therapy"
              description="Face-to-face counselling sessions in a safe, comfortable space. Available for local clients."
              href="/services#in-person"
              icon="🏠"
            />
            
            <ServiceCard 
              title="Training & Consultancy"
              description="Workshops, mentorship, and organisational support for mental health professionals and teams."
              href="/services#consultancy"
              icon="📚"
            />
          </div>
        </div>
      </div>
    </section>
    
    <!-- Trust Markers -->
    <TrustBadges />
    
    <!-- What I Work With Section -->
    <section class="py-16 md:py-20 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto fade-in">
          <h2 class="text-3xl md:text-4xl font-heading font-bold text-gray-900 mb-8 text-center">
            What I work with
          </h2>
          
          <div class="grid md:grid-cols-2 gap-6 items-start">
            <div class="bg-purple-50 rounded-lg p-6 h-full">
              <div class="flex items-start">
                <span class="text-purple-brand mr-3 text-2xl flex-shrink-0">✓</span>
                <div>
                  <h3 class="font-bold text-gray-900 mb-2">Trauma, PTSD & Complex Trauma</h3>
                  <p class="text-gray-600">Working through lasting effects of traumatic experiences</p>
                </div>
              </div>
            </div>
            
            <div class="bg-purple-50 rounded-lg p-6 h-full">
              <div class="flex items-start">
                <span class="text-purple-brand mr-3 text-2xl flex-shrink-0">✓</span>
                <div>
                  <h3 class="font-bold text-gray-900 mb-2">Depression</h3>
                  <p class="text-gray-600">Including postpartum depression, persistent low mood, and hopelessness</p>
                </div>
              </div>
            </div>
            
            <div class="bg-purple-50 rounded-lg p-6 h-full">
              <div class="flex items-start">
                <span class="text-purple-brand mr-3 text-2xl flex-shrink-0">✓</span>
                <div>
                  <h3 class="font-bold text-gray-900 mb-2">Anxiety</h3>
                  <p class="text-gray-600">Generalised anxiety, panic, social anxiety, and ongoing worry</p>
                </div>
              </div>
            </div>
            
            <div class="bg-purple-50 rounded-lg p-6 h-full">
              <div class="flex items-start">
                <span class="text-purple-brand mr-3 text-2xl flex-shrink-0">✓</span>
                <div>
                  <h3 class="font-bold text-gray-900 mb-2">Women's Mental Health & Perinatal Wellbeing</h3>
                  <p class="text-gray-600">Support during pregnancy, postpartum, birth trauma, and motherhood</p>
                </div>
              </div>
            </div>
            
            <div class="bg-purple-50 rounded-lg p-6 h-full">
              <div class="flex items-start">
                <span class="text-purple-brand mr-3 text-2xl flex-shrink-0">✓</span>
                <div>
                  <h3 class="font-bold text-gray-900 mb-2">Grief & Loss</h3>
                  <p class="text-gray-600">Navigating bereavement, miscarriage, endings, and loss</p>
                </div>
              </div>
            </div>
            
            <div class="bg-purple-50 rounded-lg p-6 h-full">
              <div class="flex items-start">
                <span class="text-purple-brand mr-3 text-2xl flex-shrink-0">✓</span>
                <div>
                  <h3 class="font-bold text-gray-900 mb-2">Burnout & Compassion Fatigue</h3>
                  <p class="text-gray-600">Work-related stress and emotional exhaustion</p>
                </div>
              </div>
            </div>
            
            <div class="bg-purple-50 rounded-lg p-6 h-full">
              <div class="flex items-start">
                <span class="text-purple-brand mr-3 text-2xl flex-shrink-0">✓</span>
                <div>
                  <h3 class="font-bold text-gray-900 mb-2">Life Transitions & Adjustment</h3>
                  <p class="text-gray-600">Career changes, relocation, relationship shifts, and uncertainty</p>
                </div>
              </div>
            </div>
            
            <div class="bg-purple-50 rounded-lg p-6 h-full">
              <div class="flex items-start">
                <span class="text-purple-brand mr-3 text-2xl flex-shrink-0">✓</span>
                <div>
                  <h3 class="font-bold text-gray-900 mb-2">Identity & Sense of Self</h3>
                  <p class="text-gray-600">Exploring identity, belonging, cultural context, and self-understanding</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
    
    <!-- Inspirational Quote -->
    <QuoteBanner
      quote="And the time came when the risk to remain tight in a bud was more painful than the risk it took to blossom."
      author="Anaïs Nin"
      backgroundImage="/images/Lavender_Home_Banner.webp"
    />

    <!-- CTA Section -->
    <CTASection />
  </main>
  
  <Footer />
</BaseLayout>
