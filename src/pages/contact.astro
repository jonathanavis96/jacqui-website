---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout 
  title="Contact - Jacqui Chowles" 
  description="Get in touch with Jacqui Chowles for therapy appointments and consultancy enquiries."
>
  <Header />
  <main class="flex-grow bg-white">
    
    <!-- Hero Section -->
    <section class="bg-gradient-to-b from-blue-50 to-white py-16 md:py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto text-center">
          <h1 class="text-4xl md:text-5xl font-heading font-bold text-gray-900 mb-6">
            Get in Touch
          </h1>
          <p class="text-xl text-gray-600 leading-relaxed">
            Book a free consultation or reach out with any questions
          </p>
        </div>
      </div>
    </section>

    <!-- Contact Methods & Form Section -->
    <section class="py-16 md:py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <div class="grid md:grid-cols-2 gap-12">
            
            <!-- Left Column - Contact Info -->
            <div>
              <h2 class="text-2xl md:text-3xl font-heading font-bold text-gray-900 mb-6">
                Contact Information
              </h2>
              
              <div class="space-y-8 mb-10">
                <!-- Email -->
                <div class="flex items-start">
                  <div class="bg-blue-100 rounded-full p-3 mr-4">
                    <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                    </svg>
                  </div>
                  <div>
                    <h3 class="font-heading font-bold text-gray-900 mb-2">Email</h3>
                    <a href="mailto:jacqui@jacquichowles.com" class="text-blue-600 hover:text-blue-700 transition-colors">
                      jacqui@jacquichowles.com
                    </a>
                    <p class="text-gray-600 text-sm mt-2">I typically respond within 24-48 hours</p>
                  </div>
                </div>

                <!-- WhatsApp -->
                <div class="flex items-start">
                  <div class="bg-blue-100 rounded-full p-3 mr-4">
                    <svg class="w-6 h-6 text-blue-600" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
                    </svg>
                  </div>
                  <div>
                    <h3 class="font-heading font-bold text-gray-900 mb-2">WhatsApp</h3>
                    <a href="https://wa.me/27123456789" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:text-blue-700 transition-colors">
                      Send a WhatsApp message
                    </a>
                    <p class="text-gray-600 text-sm mt-2">Quick queries and booking requests</p>
                  </div>
                </div>
              </div>

              <!-- What Happens Next -->
              <div class="bg-blue-50 rounded-lg p-6">
                <h3 class="text-xl font-heading font-bold text-gray-900 mb-4">
                  What happens next?
                </h3>
                <ol class="space-y-4">
                  <li class="flex items-start">
                    <span class="bg-blue-600 text-white rounded-full w-6 h-6 flex items-center justify-center text-sm font-bold mr-3 mt-0.5">1</span>
                    <div>
                      <p class="text-gray-700"><strong>I'll respond</strong> within 24-48 hours to acknowledge your message</p>
                    </div>
                  </li>
                  <li class="flex items-start">
                    <span class="bg-blue-600 text-white rounded-full w-6 h-6 flex items-center justify-center text-sm font-bold mr-3 mt-0.5">2</span>
                    <div>
                      <p class="text-gray-700"><strong>Free consultation</strong> to discuss what you're looking for and answer questions</p>
                    </div>
                  </li>
                  <li class="flex items-start">
                    <span class="bg-blue-600 text-white rounded-full w-6 h-6 flex items-center justify-center text-sm font-bold mr-3 mt-0.5">3</span>
                    <div>
                      <p class="text-gray-700"><strong>Book your first session</strong> if we're a good fit</p>
                    </div>
                  </li>
                </ol>
              </div>
            </div>

            <!-- Right Column - Contact Form -->
            <div>
              <h2 class="text-2xl md:text-3xl font-heading font-bold text-gray-900 mb-6">
                Send a Message
              </h2>
              
              <!-- Netlify Form -->
              <form 
                name="contact" 
                method="POST" 
                data-netlify="true" 
                data-netlify-honeypot="bot-field"
                class="space-y-6"
              >
                <!-- Hidden fields for Netlify -->
                <input type="hidden" name="form-name" value="contact" />
                <p class="hidden">
                  <label>
                    Don't fill this out if you're human: <input name="bot-field" />
                  </label>
                </p>

                <!-- Name -->
                <div>
                  <label for="name" class="block text-gray-700 font-bold mb-2">
                    Your Name <span class="text-red-500">*</span>
                  </label>
                  <input 
                    type="text" 
                    id="name" 
                    name="name" 
                    required 
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-600 focus:border-transparent transition-all"
                    placeholder="Enter your full name"
                  />
                </div>

                <!-- Email -->
                <div>
                  <label for="email" class="block text-gray-700 font-bold mb-2">
                    Email Address <span class="text-red-500">*</span>
                  </label>
                  <input 
                    type="email" 
                    id="email" 
                    name="email" 
                    required 
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-600 focus:border-transparent transition-all"
                    placeholder="your@email.com"
                  />
                </div>

                <!-- Phone (Optional) -->
                <div>
                  <label for="phone" class="block text-gray-700 font-bold mb-2">
                    Phone Number <span class="text-gray-500 font-normal">(optional)</span>
                  </label>
                  <input 
                    type="tel" 
                    id="phone" 
                    name="phone" 
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-600 focus:border-transparent transition-all"
                    placeholder="+27 123 456 789"
                  />
                </div>

                <!-- Service Interest -->
                <div>
                  <label for="service" class="block text-gray-700 font-bold mb-2">
                    I'm interested in <span class="text-red-500">*</span>
                  </label>
                  <select 
                    id="service" 
                    name="service" 
                    required 
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-600 focus:border-transparent transition-all"
                  >
                    <option value="">Select an option</option>
                    <option value="online-therapy">Online Therapy</option>
                    <option value="inperson-therapy">In-Person Therapy</option>
                    <option value="couples-therapy">Couples Therapy</option>
                    <option value="consultancy">Consultancy Services</option>
                    <option value="other">Other / Not sure yet</option>
                  </select>
                </div>

                <!-- Message -->
                <div>
                  <label for="message" class="block text-gray-700 font-bold mb-2">
                    Message <span class="text-red-500">*</span>
                  </label>
                  <textarea 
                    id="message" 
                    name="message" 
                    required 
                    rows="6" 
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-600 focus:border-transparent transition-all resize-none"
                    placeholder="Tell me a bit about what you're looking for or any questions you have..."
                  ></textarea>
                </div>

                <!-- Privacy Note -->
                <div class="text-sm text-gray-600 bg-gray-50 p-4 rounded-lg">
                  <p><strong>Privacy note:</strong> Your information will be kept confidential and used only to respond to your inquiry. By submitting this form, you consent to me contacting you regarding your message.</p>
                </div>

                <!-- Submit Button -->
                <button 
                  type="submit" 
                  class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-4 px-8 rounded-lg transition-colors text-lg"
                >
                  Send Message
                </button>
              </form>
            </div>

          </div>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="py-16 md:py-20 bg-blue-50">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold text-gray-900 mb-10 text-center">
            Common Questions
          </h2>

          <div class="space-y-6">
            <!-- FAQ Item -->
            <div class="bg-white rounded-lg p-6 shadow-sm">
              <h3 class="text-xl font-heading font-bold text-gray-900 mb-3">
                How do I book my first session?
              </h3>
              <p class="text-gray-700">
                Start by sending me a message via the form above, email, or WhatsApp. We'll schedule a free consultation call to discuss what you're looking for and see if we're a good fit. If we decide to work together, we'll book your first session from there.
              </p>
            </div>

            <!-- FAQ Item -->
            <div class="bg-white rounded-lg p-6 shadow-sm">
              <h3 class="text-xl font-heading font-bold text-gray-900 mb-3">
                Do you offer a free consultation?
              </h3>
              <p class="text-gray-700">
                Yes! I offer a free initial consultation (typically 15-20 minutes) to discuss your needs, answer questions, and determine if we're a good match before committing to regular sessions.
              </p>
            </div>

            <!-- FAQ Item -->
            <div class="bg-white rounded-lg p-6 shadow-sm">
              <h3 class="text-xl font-heading font-bold text-gray-900 mb-3">
                Can I see you in person or only online?
              </h3>
              <p class="text-gray-700">
                I offer both online and in-person sessions. In-person availability is limited, so contact me to discuss current openings. Online sessions are available for clients anywhere in the world.
              </p>
            </div>

            <!-- FAQ Item -->
            <div class="bg-white rounded-lg p-6 shadow-sm">
              <h3 class="text-xl font-heading font-bold text-gray-900 mb-3">
                How long does therapy take?
              </h3>
              <p class="text-gray-700">
                Every person's journey is different. Some people benefit from short-term focused work (a few months), while others prefer longer-term therapy. We'll discuss your goals and check in regularly about how things are progressing.
              </p>
            </div>

            <!-- FAQ Item -->
            <div class="bg-white rounded-lg p-6 shadow-sm">
              <h3 class="text-xl font-heading font-bold text-gray-900 mb-3">
                Do you accept medical aid?
              </h3>
              <p class="text-gray-700">
                I don't bill medical aid directly, but I can provide invoices for you to submit for reimbursement if your plan covers out-of-network providers or has mental health benefits.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Bottom CTA -->
    <section class="py-16 md:py-20 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-3xl mx-auto text-center">
          <h2 class="text-3xl md:text-4xl font-heading font-bold text-gray-900 mb-6">
            Still have questions?
          </h2>
          <p class="text-xl text-gray-600 mb-8">
            Don't hesitate to reach out. I'm here to help and answer any questions you may have.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a 
              href="mailto:jacqui@jacquichowles.com" 
              class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-bold py-4 px-8 rounded-lg transition-colors text-lg"
            >
              Send an email
            </a>
            <a 
              href="/services" 
              class="inline-block bg-white hover:bg-gray-50 text-blue-600 font-bold py-4 px-8 rounded-lg border-2 border-blue-600 transition-colors text-lg"
            >
              View services
            </a>
          </div>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>
